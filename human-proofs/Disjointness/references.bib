@article{clifford_upper_2018,
	title = {Upper and {Lower} {Bounds} for {Dynamic} {Data} {Structures} on {Strings}},
	volume = {96},
	copyright = {Creative Commons Attribution 3.0 Unported license, info:eu-repo/semantics/openAccess},
	issn = {1868-8969},
	url = {https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.STACS.2018.22},
	doi = {10.4230/LIPICS.STACS.2018.22},
	abstract = {We consider a range of simply stated dynamic data structure problems on strings. An update changes one symbol in the input and a query asks us to compute some function of the pattern of length m and a substring of a longer text. We give both conditional and unconditional lower bounds for variants of exact matching with wildcards, inner product, and Hamming distance computation via a sequence of reductions. As an example, we show that there does not exist an O(m{\textasciicircum}\{1/2-epsilon\}) time algorithm for a large range of these problems unless the online Boolean matrix-vector multiplication conjecture is false. We also provide nearly matching upper bounds for most of the problems we consider.},
	language = {en},
	urldate = {2026-11-04},
	journal = {LIPIcs, Volume 96, STACS 2018},
	publisher = {Schloss Dagstuhl – Leibniz-Zentrum für Informatik},
	author = {Clifford, Raphaël and Grønlund, Allan and Larsen, Kasper Green and Starikovskaya, Tatiana},
	editor = {Niedermeier, Rolf and Vallée, Brigitte},
	year = {2018},
	note = {Artwork Size: 14 pages, 551148 bytes
ISBN: 9783959770620
Medium: application/pdf},
	keywords = {conditional lower bounds, exact pattern matching with wildcards, hamming distance, inner product},
	pages = {22:1--22:14},
}

@article{cohen_efficient_2011,
	title = {Efficient {Stream} {Sampling} for {Variance}-{Optimal} {Estimation} of {Subset} {Sums}},
	volume = {40},
	issn = {0097-5397, 1095-7111},
	url = {https://epubs.siam.org/doi/10.1137/10079817X},
	doi = {10.1137/10079817X},
	abstract = {From a high volume stream of weighted items, we want to maintain a generic sample of a certain limited size k that we can later use to estimate the total weight of arbitrary subsets. This is the classic context of on-line reservoir sampling, thinking of the generic sample as a reservoir. We present an efficient reservoir sampling scheme, \${\textbackslash}textnormal\{{\textbackslash}sc VarOptk\}\$, that dominates all previous schemes in terms of estimation quality. \${\textbackslash}textnormal\{{\textbackslash}sc VarOptk\}\$ provides variance optimal unbiased estimation of subset sums. More precisely, if we have seen n items of the stream, then for any subset size m, our scheme based on k samples minimizes the average variance over all subsets of size m. In fact, the optimality is against any off-line scheme with k samples tailored for the concrete set of items seen. In addition to optimal average variance, our scheme provides tighter worst-case bounds on the variance of particular subsets than previously possible. It is efficient, handling each new item of the stream in \$O({\textbackslash}log k)\$ time. Finally, it is particularly well suited for combinations of samples from different streams in a distributed setting.},
	language = {en},
	number = {5},
	urldate = {2026-10-28},
	journal = {SIAM Journal on Computing},
	author = {Cohen, Edith and Duffield, Nick and Kaplan, Haim and Lund, Carsten and Thorup, Mikkel},
	month = jan,
	year = {2011},
	pages = {1402--1431},
}

@article{golan_streaming_2020,
	title = {The {Streaming} k-{Mismatch} {Problem}: {Tradeoffs} {Between} {Space} and {Total} {Time}},
	volume = {161},
	copyright = {Creative Commons Attribution 3.0 Unported license, info:eu-repo/semantics/openAccess},
	issn = {1868-8969},
	shorttitle = {The {Streaming} k-{Mismatch} {Problem}},
	url = {https://drops.dagstuhl.de/entities/document/10.4230/LIPIcs.CPM.2020.15},
	doi = {10.4230/LIPICS.CPM.2020.15},
	abstract = {We revisit the k-mismatch problem in the streaming model on a pattern of length m and a streaming text of length n, both over a size-σ alphabet. The current state-of-the-art algorithm for the streaming k-mismatch problem, by Clifford et al. [SODA 2019], uses Õ(k) space and Õ(√k) worst-case time per character. The space complexity is known to be (unconditionally) optimal, and the worst-case time per character matches a conditional lower bound. However, there is a gap between the total time cost of the algorithm, which is Õ(n√k), and the fastest known offline algorithm, which costs Õ(n + min(nk/√m, σn)) time. Moreover, it is not known whether improvements over the Õ(n√k) total time are possible when using more than O(k) space.
We address these gaps by designing a randomized streaming algorithm for the k-mismatch problem that, given an integer parameter k≤s≤m, uses Õ(s) space and costs Õ(n+min(nk²/m, nk/√s, σnm/s)) total time. For s=m, the total runtime becomes Õ(n + min(nk/√m, σn)), which matches the time cost of the fastest offline algorithm. Moreover, the worst-case time cost per character is still Õ(√k).},
	language = {en},
	urldate = {2026-10-28},
	journal = {LIPIcs, Volume 161, CPM 2020},
	publisher = {Schloss Dagstuhl – Leibniz-Zentrum für Informatik},
	author = {Golan, Shay and Kociumaka, Tomasz and Kopelowitz, Tsvi and Porat, Ely},
	editor = {Gørtz, Inge Li and Weimann, Oren},
	year = {2020},
	note = {Artwork Size: 15 pages, 559687 bytes
ISBN: 9783959771498
Medium: application/pdf},
	keywords = {Hamming distance, Streaming pattern matching, Theory of computation → Pattern matching, k-mismatch},
	pages = {15:1--15:15},
}

