@article{chiba_arboricity_1985,
	title = {Arboricity and {Subgraph} {Listing} {Algorithms}},
	volume = {14},
	issn = {0097-5397, 1095-7111},
	url = {https://epubs.siam.org/doi/10.1137/0214017},
	doi = {10.1137/0214017},
	abstract = {In this paper we introduce a new simple strategy into edge-searching of a graph, which is useful to the various subgraph listing problems. Applying the strategy, we obtain the following four algorithms. The first one lists all the triangles in a graph G in \$O(a(G)m)\$ time, where m is the number of edges of G and \$a(G)\$ the arboricity of G. The second finds all the quadrangles in \$O(a(G)m)\$ time. Since \$a(G)\$ is at most three for a planar graph G, both run in linear time for a planar graph. The third lists all the complete subgraphs \$K\_l \$ of order l in \$O(la(G){\textasciicircum}\{l - 2\} m)\$ time. The fourth lists all the cliques in \$O(a(G)m)\$ time per clique. All the algorithms require linear space. We also establish an upper bound on \$a(G)\$ for a graph \$G:a(G) {\textbackslash}leqq {\textbackslash}lceil (2m + n){\textasciicircum}\{1/2\} {\textbackslash}rceil \$, where n is the number of vertices in G.},
	language = {en},
	number = {1},
	urldate = {2026-10-23},
	journal = {SIAM Journal on Computing},
	author = {Chiba, Norishige and Nishizeki, Takao},
	month = feb,
	year = {1985},
	pages = {210--223},
}

@misc{ko_omegalog_2026,
	title = {\${\textbackslash}{Omega}(({\textbackslash}log n/{\textbackslash}log{\textbackslash}log n){\textasciicircum}2)\$ {Lower} {Bounds} for {Dynamic} {Graph} {Problems}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2610.10904},
	doi = {10.48550/ARXIV.2610.10904},
	abstract = {We prove an \${\textbackslash}Omega(({\textbackslash}log n/{\textbackslash}log{\textbackslash}log n){\textasciicircum}2)\$ unconditional lower bound on the maximum of the update time and the query time for Pătraşcu's multiphase problem [STOC 2010] with Disjointness, in its insert-only form. Through his reductions, we obtain the same lower bound for dynamic data structures supporting reachability queries in \$n\$-node directed acyclic graphs under edge insertions, improving the \${\textbackslash}widetildeΩ({\textbackslash}log{\textasciicircum}\{3/2\} n)\$ lower bound of Larsen and Yu [SICOMP 2025], and matching the strongest lower bound known for any dynamic problem. The same bound holds for many other dynamic problems: in directed graphs, for incremental \$s\$-\$t\$ reachability, strong connectivity and cycle detection; in undirected graphs, for incremental shortest paths, subgraph connectivity and triangle detection; and for dynamic set disjointness, range mode, and Langerman's, Pagh's and Erickson's problems.
 Ko [FOCS 2026] recently proved this bound for a variant of the multiphase problem with Inner Product in place of Disjointness, via a 2.5-round multiphase communication game; we bring this framework to the original problem. Our main technical contribution is to show that verification in this game makes a one-sided corruption bound suffice in place of discrepancy, which Disjointness lacks.},
	urldate = {2026-10-23},
	publisher = {arXiv},
	author = {Ko, Young Kun},
	month = oct,
	year = {2026},
	note = {Version Number: 2},
	keywords = {Computational Complexity (cs.CC), Data Structures and Algorithms (cs.DS), FOS: Computer and information sciences},
}

@misc{karingula_simplified_2026,
	title = {A simplified proof of polynomial improvements for {3SUM} and {APSP}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2610.15663},
	doi = {10.48550/ARXIV.2610.15663},
	abstract = {We give a simplified proof of the polynomial improvements for integer 3SUM and all-pairs shortest paths (APSP) established by Alman and Vassilevska Williams, with weaker exponents. The central ingredient is selected-entry matrix multiplication: computing a prescribed set of entries of a product of dense rectangular matrices. Starting from Schönhage's inner/outer-product identity, we construct a multiplication rule that shares intermediate products among many outputs. We apply this rule recursively and bound the work by counting the requested entries at each level.
 Applied to incidence matrices, the algorithm solves Offline Set Disjointness over a small universe. Known deterministic reductions then yield truly subquadratic integer 3SUM and truly subcubic APSP for polynomially bounded integer inputs.},
	urldate = {2026-10-16},
	publisher = {arXiv},
	author = {Karingula, Sankeerth Rao and Lovett, Shachar},
	month = oct,
	year = {2026},
	note = {Version Number: 1},
	keywords = {68Q25, 68W30, 05C85, Computational Complexity (cs.CC), F.2.2; F.2.1, FOS: Computer and information sciences},
}

