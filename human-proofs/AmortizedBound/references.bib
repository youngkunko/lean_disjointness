@inproceedings{ko_omega_2026,
	title = {An \${\textbackslash}{Omega}( ({\textbackslash}log n / {\textbackslash}log {\textbackslash}log n){\textasciicircum}2 )\$ {Cell}-{Probe} {Lower} {Bound} for {Dynamic} {Boolean} {Data} {Structures}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2603.25914},
	doi = {10.48550/ARXIV.2603.25914},
	abstract = {We resolve the long-standing open problem of Boolean dynamic data structure hardness, proving an unconditional lower bound of \$Ω(({\textbackslash}log n / {\textbackslash}log{\textbackslash}log n){\textasciicircum}2)\$ for the Multiphase Problem of Patrascu [STOC 2010] (instantiated with Inner Product over \${\textbackslash}mathbb\{F\}\_2\$). This matches the celebrated barrier for weighted problems established by Larsen [STOC 2012] and closes the gap left by the \$Ω({\textbackslash}log{\textasciicircum}\{1.5\} n)\$ Boolean bound of Larsen, Weinstein, and Yu [STOC 2018].
 The previous barrier was methodological: all prior works relied on ``one-way'' communication games, where the inability to verify query simulations necessitated complex machinery (such as the Peak-to-Average Lemma) that hit a hard ceiling at \${\textbackslash}log{\textasciicircum}\{1.5\} n\$.
 Our key contribution is conceptual: We introduce a 2.5-round Multiphase Communication Game that augments the standard one-way model with a verification round, where Bob confirms the consistency of Alice's simulation against the actual memory. This simple, qualitative change allows us to bypass technical barriers and obtain the optimal bound directly. As a consequence, our analysis naturally extends to other hard Boolean functions, offering a general recipe for translating discrepancy lower bounds into \$Ω(({\textbackslash}log n / {\textbackslash}log{\textbackslash}log n){\textasciicircum}2)\$ dynamic Boolean data structure lower bounds.
 We also argue that this result likely represents the structural ceiling of the Chronogram framework initiated by Fredman and Saks [STOC 1989]: any \$ω({\textbackslash}log{\textasciicircum}2 n)\$ lower bound would require either fundamentally new techniques or major circuit complexity breakthroughs.},
	urldate = {2026-05-21},
	booktitle = {Proceedings of the 67th {IEEE} {Symposium} on {Foundations} of {Computer} {Science} ({FOCS}) (to appear)},
	publisher = {IEEE},
	author = {Ko, Young Kun},
	year = {2026},
	keywords = {Computational Complexity (cs.CC), Data Structures and Algorithms (cs.DS), FOS: Computer and information sciences, Information Theory (cs.IT)},
}

