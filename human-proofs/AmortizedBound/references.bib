@article{sason_reverse_2015,
	title = {On {Reverse} {Pinsker} {Inequalities}},
	url = {http://arxiv.org/abs/1503.07118},
	abstract = {New upper bounds on the relative entropy are derived as a function of the total variation distance. One bound refines an inequality by Verd{\textbackslash}'\{u\} for general probability measures. A second bound improves the tightness of an inequality by Csisz{\textbackslash}'\{a\}r and Talata for arbitrary probability measures that are defined on a common finite set. The latter result is further extended, for probability measures on a finite set, leading to an upper bound on the R{\textbackslash}'\{e\}nyi divergence of an arbitrary non-negative order (including \${\textbackslash}infty\$) as a function of the total variation distance. Another lower bound by Verd{\textbackslash}'\{u\} on the total variation distance, expressed in terms of the distribution of the relative information, is tightened and it is attained under some conditions. The effect of these improvements is exemplified.},
	urldate = {2020-02-12},
	journal = {arXiv:1503.07118 [cs, math]},
	author = {Sason, Igal},
	month = apr,
	year = {2015},
	note = {arXiv: 1503.07118},
	keywords = {Computer Science - Information Theory, Mathematics - Probability},
}

@article{bar-yossef_index_2011,
	title = {Index {Coding} {With} {Side} {Information}},
	volume = {57},
	issn = {1557-9654},
	doi = {10.1109/TIT.2010.2103753},
	abstract = {Motivated by a problem of transmitting supplemental data over broadcast channels (Birk and Kol, INFOCOM 1998), we study the following coding problem: a sender communicates with n receivers R1,..., Rn. He holds an input x ∈ 0,01ln and wishes to broadcast a single message so that each receiver Ri can recover the bit xi. Each Ri has prior side information about x, induced by a directed graph Grain nodes; Ri knows the bits of a; in the positions j {\textbar} (i,j) is an edge of G.G is known to the sender and to the receivers. We call encoding schemes that achieve this goal INDEXcodes for 0,1n with side information graph G. In this paper we identify a measure on graphs, the minrank, which exactly characterizes the minimum length of linear and certain types of nonlinear INDEX codes. We show that for natural classes of side information graphs, including directed acyclic graphs, perfect graphs, odd holes, and odd anti-holes, minrank is the optimal length of arbitrary INDEX codes. For arbitrary INDEX codes and arbitrary graphs, we obtain a lower bound in terms of the size of the maximum acyclic induced subgraph. This bound holds even for randomized codes, but has been shown not to be tight.},
	number = {3},
	journal = {IEEE Transactions on Information Theory},
	author = {Bar-Yossef, Ziv and Birk, Yitzhak and Jayram, T. S. and Kol, Tomer},
	month = mar,
	year = {2011},
	keywords = {Broadcast channels, Channel coding, Decoding, Indexes, Receivers, Servers, Vectors, arbitrary index codes, broadcast channels, code length, computational complexity, directed acyclic graphs, directed graphs, encoding schemes, error correction coding, information cost, linear codes, maximum acyclic induced subgraph, minrank, nonlinear codes, nonlinear index codes, odd antiholes, odd holes, perfect graphs, randomized codes, side information graphs},
	pages = {1479--1494},
}

@article{harvey_capacity_2006,
	title = {On the capacity of information networks},
	volume = {52},
	issn = {1557-9654},
	doi = {10.1109/TIT.2006.874531},
	abstract = {An outer bound on the rate region of noise-free information networks is given. This outer bound combines properties of entropy with a strong information inequality derived from the structure of the network. This blend of information theoretic and graph theoretic arguments generates many interesting results. For example, the capacity of directed cycles is characterized. Also, a gap between the sparsity of an undirected graph and its capacity is shown. Extending this result, it is shown that multicommodity flow solutions achieve the capacity in an infinite class of undirected graphs, thereby making progress on a conjecture of Li and Li. This result is in sharp contrast to the situation with directed graphs, where a family of graphs is presented in which the gap between the capacity and the rate achievable using multicommodity flows is linear in the size of the graph.},
	number = {6},
	journal = {IEEE Transactions on Information Theory},
	author = {Harvey, N.J.A. and Kleinberg, R. and Lehman, A.R.},
	month = jun,
	year = {2006},
	keywords = {Artificial intelligence, Capacity, Computer networks, Computer science, Cramer-Rao bounds, Entropy, Information theory, Interference, Laboratories, Network coding, Unicast, channel capacity, directed graph, directed graphs, entropy, entropy codes, graph theory, infomational dominance, information network capacity, information theory, multicommodity flow, multicommodity flow solution, multiple unicast sessions, network coding, sparsity},
	pages = {2345--2364},
}

@article{riis_information_2007,
	title = {Information {Flows}, {Graphs} and their {Guessing} {Numbers} {\textbar} {The} {Electronic} {Journal} of {Combinatorics}},
	volume = {14},
	url = {https://www.combinatorics.org/ojs/index.php/eljc/article/view/v14i1r44},
	abstract = {Valiant's shift problem asks whether all \$n\$ cyclic shifts on \$n\$ bits can be realized if \$n{\textasciicircum}\{(1+{\textbackslash}epsilon)\}\$ input output pairs (\${\textbackslash}epsilon  {\textless}  1\$) are directly connected and there are additionally \$m\$ common bits available that can be arbitrary functions of all the inputs. If it could be shown that this is not realizable with \$m = O(\{n{\textbackslash}over {\textbackslash}log {\textbackslash}log n\})\$ common bits then a significant breakthrough in Boolean circuit complexity would follow. In this paper it is shown that in certain cases all cyclic shifts are realizable with \$m=(n- n{\textasciicircum}\{{\textbackslash}epsilon\})/2\$ common bits.  Previously, no solution with \$m  {\textless}  n - o(n)\$ was known, and Valiant had conjectured that \$m  {\textless}  n/2\$ was not achievable. The construction therefore establishes a novel way of realizing communication in the manner of Network Coding for the shift problem, but leaves the viability of the common information approach to proving lower bounds in Circuit Complexity open. The construction uses the graph-theoretic notion of guessing number. As a by-product the paper also establish an interesting link between Circuit Complexity and Network Coding, a new direction of research in multiuser information theory.},
	language = {en-US},
	urldate = {2019-12-11},
	journal = {Electronic Journal of Combinatorics},
	author = {Riis, Søren},
	year = {2007},
}

@article{patrascu_logarithmic_2006,
	title = {Logarithmic {Lower} {Bounds} in the {Cell}-{Probe} {Model}},
	volume = {35},
	issn = {0097-5397},
	url = {http://dx.doi.org/10.1137/S0097539705447256},
	doi = {10.1137/S0097539705447256},
	abstract = {We develop a new technique for proving cell-probe lower bounds on dynamic data structures. This technique enables us to prove an amortized randomized \${\textbackslash}Omega({\textbackslash}lg n)\$ lower bound per operation for several data structural problems on \$n\$ elements, including partial sums, dynamic connectivity among disjoint paths (or a forest or a graph), and several other dynamic graph problems (by simple reductions). Such a lower bound breaks a long-standing barrier of \${\textbackslash}Omega({\textbackslash}lg n{\textbackslash},/{\textbackslash}lg{\textbackslash}lg n)\$ for any dynamic language membership problem. It also establishes the optimality of several existing data structures, such as Sleator and Tarjan's dynamic trees. We also prove the first \${\textbackslash}Omega({\textbackslash}log\_B n)\$ lower bound in the external-memory model without assumptions on the data structure (such as the comparison model). Our lower bounds also give a query-update trade-off curve matched, e.g., by several data structures for dynamic connectivity in graphs. We also prove matching upper and lower bounds for partial sums when parameterized by the word size and the maximum additive change in an update.},
	number = {4},
	urldate = {2019-03-22},
	journal = {SIAM J. Comput.},
	author = {Patrascu, Mihai and Demaine, Erik D.},
	month = apr,
	year = {2006},
	keywords = {cell-probe complexity, data structures, dynamic graph problems, lower bounds, partial-sums problem},
	pages = {932--963},
}

