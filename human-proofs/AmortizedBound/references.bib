@article{yu_nearly_2022,
	title = {Nearly {Optimal} {Static} {Las} {Vegas} {Succinct} {Dictionary}},
	volume = {51},
	issn = {0097-5397, 1095-7111},
	url = {https://epubs.siam.org/doi/10.1137/20M1363649},
	doi = {10.1137/20M1363649},
	abstract = {For positive integers \$U\$, \$n\$, and \${\textbackslash}sigma\$, given a set \$S\$ of \$n\$ (distinct) keys from key space \$[U]\$, each associated with a value from \$[{\textbackslash}sigma]\$, the static dictionary problem asks one to preprocess these (key, value) pairs into a data structure, supporting value-retrieval queries: for any given \$x{\textbackslash}in [U]\$, \$\{valRet\}(x)\$ must return the value associated with \$x\$ if \$x{\textbackslash}in S\$, or return \${\textbackslash}bot\$ if \$x{\textbackslash}notin S\$. The special case where \${\textbackslash}sigma=1\$ is called the membership problem. The “textbook” solution is to use a hash table, which occupies linear space and answers each query in constant time. On the other hand, the minimum possible space to encode all (key, value) pairs is only \$\{OPT\}:= {\textbackslash}lceil{\textbackslash}lg\_2{\textbackslash}binom\{U\}\{n\}+n{\textbackslash}lg\_2 {\textbackslash}sigma{\textbackslash}rceil\$ bits, which could be much smaller than a hash table. In this paper, we design a randomized dictionary data structure using \$\{OPT\}+\{poly\}{\textbackslash}lg n+O({\textbackslash}lg{\textasciicircum}\{({\textbackslash}ell)\} U)\$ bits of space, and it has expected constant query time, assuming the query algorithm can access an external lookup table of size \$n{\textasciicircum}\{{\textbackslash}epsilon\}\$ for any constant \${\textbackslash}ell\$ and \${\textbackslash}epsilon\$. The lookup table depends only on \$U\$, \$n\$, and \${\textbackslash}sigma\$, and not the input. Previously, even for membership queries and \$U{\textbackslash}leq n{\textasciicircum}\{O(1)\}\$, the best known data structure with constant query time requires \$\{OPT\}+n/\{poly\}{\textbackslash}lg n\$ bits of space (Pagh [ SIAM J. Comput., 31 (2001), pp. 353--363] and Pǎtraşcu [ FOCS, IEEE Computer Society, Los Alamitos, CA, 2008, pp. 305--313]); the best known using \$\{OPT\}+n{\textasciicircum}\{1-{\textbackslash}epsilon\}\$ space has query time \$O({\textbackslash}lg n)\$. Our new data structure answers open questions by Pǎtraşcu and Thorup [ FOCS, IEEE Computer Society, Los Alamitos, CA, 2008, pp. 305--313; Bull. Eur. Assoc. Theor. Comput. Sci. EATCS, 109 (2013), pp. 7--13]. We also present a scheme that compresses a sequence \$X{\textbackslash}in[{\textbackslash}sigma]{\textasciicircum}n\$ to its zeroth order (empirical) entropy up to \${\textbackslash}sigma{\textbackslash}cdot\{poly\}{\textbackslash}lg n\$ extra bits, supporting decoding each \$X\_i\$ in \$O({\textbackslash}lg {\textbackslash}sigma)\$ expected time.},
	language = {en},
	number = {3},
	urldate = {2026-11-03},
	journal = {SIAM Journal on Computing},
	author = {Yu, Huacheng},
	month = jun,
	year = {2022},
	pages = {STOC20--174--STOC20--249},
}

