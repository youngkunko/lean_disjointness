@misc{bruning_solving_2026,
	title = {Solving {Proximity} {Problems} for {Polygonal} {Shapes} via {Polynomials}},
	copyright = {arXiv.org perpetual, non-exclusive license},
	url = {https://arxiv.org/abs/2308.05998},
	doi = {10.48550/ARXIV.2308.05998},
	abstract = {We study range spaces, where the ground set consists of either polygonal curves in \${\textbackslash}mathbb\{R\}{\textasciicircum}d\$ or polygonal regions in the plane that may contain holes and the ranges are balls defined by distance measures, such as the Hausdorff distance, the Fréchet distance and the dynamic time warping distance. These range spaces appear in various applications like classification, simplification, range searching, density estimation and clustering when the instances are trajectories, time series or polygons. We show for the Fréchet distance of polygonal curves and the Hausdorff distance of polygonal curves and planar polygonal regions that the VC-dimension is upper-bounded by \$O(dk{\textbackslash}log(km))\$, where \$k\$ is the complexity of the center of a ball, \$m\$ is the complexity of each polygonal curve or region in the ground set, and \$d\$ is the ambient dimension. For \$d {\textbackslash}geq 4\$ this bound is tight in each of the parameters \$d,k\$ and \$m\$ separately. For a variant of dynamic time warping distance of polygonal curves using squared distances, our analysis directly yields an upper-bound of \$O({\textbackslash}min(dk{\textasciicircum}2{\textbackslash}log(m),dkm{\textbackslash}log(k)))\$. We also obtain exact solutions that are hitherto unknown for simplification, range searching, nearest neighbor search, and distance oracle.},
	urldate = {2026-11-02},
	publisher = {arXiv},
	author = {Brüning, Frederik and Cheng, Siu-Wing and Driemel, Anne and Huang, Haoqiang},
	month = aug,
	year = {2026},
	note = {Version Number: 3},
	keywords = {Computational Geometry (cs.CG), FOS: Computer and information sciences},
}

