@misc{ko_omegalog_2026,
	title = {\${\textbackslash}{Omega}(({\textbackslash}log n/{\textbackslash}log{\textbackslash}log n){\textasciicircum}2)\$ {Lower} {Bounds} for {Dynamic} {Graph} {Problems}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2610.10904},
	doi = {10.48550/ARXIV.2610.10904},
	abstract = {We prove an \${\textbackslash}Omega(({\textbackslash}log n/{\textbackslash}log{\textbackslash}log n){\textasciicircum}2)\$ unconditional lower bound on the maximum of the update time and the query time for Pătraşcu's multiphase problem [STOC 2010] with Disjointness, in its insert-only form. Through his reductions, we obtain the same lower bound for dynamic data structures supporting reachability queries in \$n\$-node directed acyclic graphs under edge insertions, improving the \${\textbackslash}widetildeΩ({\textbackslash}log{\textasciicircum}\{3/2\} n)\$ lower bound of Larsen and Yu [SICOMP 2025], and matching the strongest lower bound known for any dynamic problem. The same bound holds for many other dynamic problems: in directed graphs, for incremental \$s\$-\$t\$ reachability, strong connectivity and cycle detection; in undirected graphs, for incremental shortest paths, subgraph connectivity and triangle detection; and for dynamic set disjointness, range mode, and Langerman's, Pagh's and Erickson's problems.
 Ko [FOCS 2026] recently proved this bound for a variant of the multiphase problem with Inner Product in place of Disjointness, via a 2.5-round multiphase communication game; we bring this framework to the original problem. Our main technical contribution is to show that verification in this game makes a one-sided corruption bound suffice in place of discrepancy, which Disjointness lacks.},
	urldate = {2026-10-23},
	publisher = {arXiv},
	author = {Ko, Young Kun},
	month = oct,
	year = {2026},
	note = {Version Number: 2},
	keywords = {Computational Complexity (cs.CC), Data Structures and Algorithms (cs.DS), FOS: Computer and information sciences},
}

@misc{alman_truly_2026,
	title = {Truly {Subquadratic} {3SUM} and {Truly} {Subcubic} {APSP} via {Triangles} in {Sparse} {Lopsided} {Graphs}},
	url = {http://arxiv.org/abs/2610.06783},
	doi = {10.48550/arXiv.2610.06783},
	abstract = {We give the first polynomial improvements over the textbook algorithms for \$3\$SUM and All-Pairs Shortest Paths (APSP): we show how to deterministically solve \$3\$SUM on \$n\$ integers of polynomial size in \$O(n{\textasciicircum}\{1.9992\})\$ time and APSP on directed \$n\$-vertex graphs with polynomially bounded integer weights in \$O(n{\textasciicircum}\{2.9995\})\$ time. This refutes the \$3\$SUM and APSP hypotheses. Using known reductions, we also refute the real-valued versions of the \$3\$SUM and APSP hypotheses, the Exact Triangle hypothesis, the Zero-Weight \$k\$-Clique hypotheses, and the three rectangular hinted Online Matrix--Vector conjectures of van den Brand, Nanongkai, and Saranurak, and we give polynomial speedups for a variety of other problems. All of these results follow from a single new algorithm for thin matrix products. Let \$X\$ be an \$N{\textbackslash}times D\$ integer matrix and \$Y\$ a \$D{\textbackslash}times N\$ integer matrix with \$D{\textbackslash}le N{\textasciicircum}\{1/18\}\$, and let \$W\$ be any set of at most \$N{\textasciicircum}2/{\textbackslash}sqrt D\$ positions. We compute the entries \$(XY)[I,J]\$, \$(I,J){\textbackslash}in W\$, in \$O(N{\textasciicircum}2/D{\textasciicircum}\{0.063\})\$ operations, which is polynomially less than the time needed to write down \$XY\$ or to compute \$N{\textasciicircum}2/{\textbackslash}sqrt D\$ inner products one by one. We design this algorithm by modifying a variant of Coppersmith's rectangular matrix multiplication algorithm, built from a ten-multiplication identity of Schönhage, to perform only the operations needed for the entries in \$W\$, and show that few operations are needed. Interpreted as a graph algorithm, this solves the All-Edges Sparse Triangle problem in truly subquadratic time on sparse lopsided tripartite graphs where two parts have \$n\$ vertices but one part has \$n{\textasciicircum}\{{\textbackslash}varepsilon\}\$ vertices for \${\textbackslash}varepsilon{\textless}0.12\$. By known reductions, Exact Triangle, and hence \$3\$SUM and APSP, reduce to this problem. We also give a data structure version that answers queries for single entries of \$XY\$, not known in advance.},
	urldate = {2026-10-06},
	publisher = {arXiv},
	author = {Alman, Josh and Williams, Virginia Vassilevska},
	month = oct,
	year = {2026},
	note = {arXiv:2610.06783 [cs.DS]},
	keywords = {Computer Science - Computational Complexity, Computer Science - Data Structures and Algorithms},
}

@inproceedings{ko_omega_2026,
	title = {An \${\textbackslash}{Omega}( ({\textbackslash}log n / {\textbackslash}log {\textbackslash}log n){\textasciicircum}2 )\$ {Cell}-{Probe} {Lower} {Bound} for {Dynamic} {Boolean} {Data} {Structures}},
	copyright = {Creative Commons Attribution 4.0 International},
	url = {https://arxiv.org/abs/2603.25914},
	doi = {10.48550/ARXIV.2603.25914},
	abstract = {We resolve the long-standing open problem of Boolean dynamic data structure hardness, proving an unconditional lower bound of \$Ω(({\textbackslash}log n / {\textbackslash}log{\textbackslash}log n){\textasciicircum}2)\$ for the Multiphase Problem of Patrascu [STOC 2010] (instantiated with Inner Product over \${\textbackslash}mathbb\{F\}\_2\$). This matches the celebrated barrier for weighted problems established by Larsen [STOC 2012] and closes the gap left by the \$Ω({\textbackslash}log{\textasciicircum}\{1.5\} n)\$ Boolean bound of Larsen, Weinstein, and Yu [STOC 2018].
 The previous barrier was methodological: all prior works relied on ``one-way'' communication games, where the inability to verify query simulations necessitated complex machinery (such as the Peak-to-Average Lemma) that hit a hard ceiling at \${\textbackslash}log{\textasciicircum}\{1.5\} n\$.
 Our key contribution is conceptual: We introduce a 2.5-round Multiphase Communication Game that augments the standard one-way model with a verification round, where Bob confirms the consistency of Alice's simulation against the actual memory. This simple, qualitative change allows us to bypass technical barriers and obtain the optimal bound directly. As a consequence, our analysis naturally extends to other hard Boolean functions, offering a general recipe for translating discrepancy lower bounds into \$Ω(({\textbackslash}log n / {\textbackslash}log{\textbackslash}log n){\textasciicircum}2)\$ dynamic Boolean data structure lower bounds.
 We also argue that this result likely represents the structural ceiling of the Chronogram framework initiated by Fredman and Saks [STOC 1989]: any \$ω({\textbackslash}log{\textasciicircum}2 n)\$ lower bound would require either fundamentally new techniques or major circuit complexity breakthroughs.},
	urldate = {2026-05-21},
	booktitle = {Proceedings of the 67th {IEEE} {Symposium} on {Foundations} of {Computer} {Science} ({FOCS}) (to appear)},
	publisher = {IEEE},
	author = {Ko, Young Kun},
	year = {2026},
	keywords = {Computational Complexity (cs.CC), Data Structures and Algorithms (cs.DS), FOS: Computer and information sciences, Information Theory (cs.IT)},
}

