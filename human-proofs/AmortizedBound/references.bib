@inproceedings{bennett_quantitative_2017,
	title = {On the {Quantitative} {Hardness} of {CVP}},
	issn = {0272-5428},
	doi = {10.1109/FOCS.2017.11},
	abstract = {For odd integers p ≥ 1 (and p = ∞), we show that the Closest Vector Problem in the ℓp norm (CVPp) over rank n lattices cannot be solved in 2(1-ε)n time for any constant ε {\textgreater} 0 unless the Strong Exponential Time Hypothesis (SETH) fails. We then extend this result to “almost all” values of p ≥ 1, not including the even integers. This comes tantalizingly close to settling the quantitative time complexity of the important special case of CVP2 (i.e., CVP in the Euclidean norm), for which a 2n+o(n)-time algorithm is known. In particular, our result applies for any p = p(n) ≠ 2 that approaches 2 as n → ∞. We also show a similar SETH-hardness result for SVP∞; hardness of approximating CVPp to within some constant factor under the so-called Gap-ETH assumption; and other hardness results for CVPp and CVPPp for any 1 ≤ p {\textless}; ∞ under different assumptions.},
	booktitle = {2017 {IEEE} 58th {Annual} {Symposium} on {Foundations} of {Computer} {Science} ({FOCS})},
	author = {Bennett, Huck and Golovnev, Alexander and Stephens-Davidowitz, Noah},
	month = oct,
	year = {2017},
	keywords = {Approximation algorithms, CVP, CVP quantitative hardness, Closest Vector Problem, Complexity theory, Cryptography, Electronic mail, Euclidean norm, Fine-grained complexity, Heuristic algorithms, Lattices, Linear programming, SETH, approximation theory, closest vector problem, computational complexity, hardness, odd integers, quantitative time complexity, similar SETH-hardness result, strong exponential time hypothesis, vectors},
	pages = {13--24},
}

@inproceedings{aggarwal_gapseth_2018,
	address = {New York, NY, USA},
	series = {{STOC} 2018},
	title = {({Gap}/{S}){ETH} hardness of {SVP}},
	isbn = {978-1-4503-5559-9},
	url = {https://doi.org/10.1145/3188745.3188840},
	doi = {10.1145/3188745.3188840},
	abstract = {We prove the following quantitative hardness results for the Shortest Vector Problem in the ℓp norm (SVP\_p), where n is the rank of the input lattice. For “almost all” p {\textgreater} p0 ≈ 2.1397, there is no 2n/Cp-time algorithm for SVP\_p for some explicit (easily computable) constant Cp {\textgreater} 0 unless the (randomized) Strong Exponential Time Hypothesis (SETH) is false. (E.g., for p ≥ 3, Cp {\textless} 1 + (p+3) 2−p + 10 p2 2−2p.) For any 1 ≤ p ≤ ∞, there is no 2o(n)-time algorithm for SVP\_p unless the non-uniform Gap-Exponential Time Hypothesis (Gap-ETH) is false. Furthermore, for each such p, there exists a constant γp {\textgreater} 1 such that the same result holds even for γp-approximate SVP\_p. For p {\textgreater} 2, the above statement holds under the weaker assumption of randomized Gap-ETH. I.e., there is no 2o(n)-time algorithm for γp-approximate SVP\_p unless randomized Gap-ETH is false. See http://arxiv.org/abs/1712.00942 for a complete exposition.},
	urldate = {2020-08-27},
	booktitle = {Proceedings of the 50th {Annual} {ACM} {SIGACT} {Symposium} on {Theory} of {Computing}},
	publisher = {Association for Computing Machinery},
	author = {Aggarwal, Divesh and Stephens-Davidowitz, Noah},
	month = jun,
	year = {2018},
	keywords = {SVP, fine-grained complexity, lattices, quantitative hardness},
	pages = {228--238},
}

@article{aggarwal_fine-grained_2020,
	title = {Fine-grained hardness of {CVP}({P}) -- {Everything} that we can prove (and nothing else)},
	url = {http://arxiv.org/abs/1911.02440},
	abstract = {We show a number of fine-grained hardness results for the Closest Vector Problem in the \${\textbackslash}ell\_p\$ norm (\${\textbackslash}mathrm\{CVP\}\_p\$), and its approximate and non-uniform variants. First, we show that \${\textbackslash}mathrm\{CVP\}\_p\$ cannot be solved in \$2{\textasciicircum}\{(1-{\textbackslash}varepsilon)n\}\$ time for all \$p {\textbackslash}notin 2{\textbackslash}mathbb\{Z\}\$ and \${\textbackslash}varepsilon {\textgreater} 0\$, assuming the Strong Exponential Time Hypothesis (SETH). Second, we extend this by showing that there is no \$2{\textasciicircum}\{(1-{\textbackslash}varepsilon)n\}\$-time algorithm for approximating \${\textbackslash}mathrm\{CVP\}\_p\$ to within a constant factor \${\textbackslash}gamma\$ for such \$p\$ assuming a "gap" version of SETH, with an explicit relationship between \${\textbackslash}gamma\$, \$p\$, and the arity \$k = k({\textbackslash}varepsilon)\$ of the underlying hard CSP. Third, we show the same hardness result for (exact) \${\textbackslash}mathrm\{CVP\}\_p\$ with preprocessing (assuming non-uniform SETH). For exact "plain" \${\textbackslash}mathrm\{CVP\}\_p\$, the same hardness result was shown in [Bennett, Golovnev, and Stephens-Davidowitz FOCS 2017] for all but finitely many \$p {\textbackslash}notin 2{\textbackslash}mathbb\{Z\}\$, where the set of exceptions depended on \${\textbackslash}varepsilon\$ and was not explicit. For the approximate and preprocessing problems, only very weak bounds were known prior to this work. We also show that the restriction to \$p {\textbackslash}notin 2{\textbackslash}mathbb\{Z\}\$ is in some sense inherent. In particular, we show that no "natural" reduction can rule out even a \$2{\textasciicircum}\{3n/4\}\$-time algorithm for \${\textbackslash}mathrm\{CVP\}\_2\$ under SETH. For this, we prove that the possible sets of closest lattice vectors to a target in the \${\textbackslash}ell\_2\$ norm have quite rigid structure, which essentially prevents them from being as expressive as \$3\$-CNFs. We prove these results using techniques from many different fields, including complex analysis, functional analysis, additive combinatorics, and discrete Fourier analysis. E.g., along the way, we give a new (and tighter) proof of Szemer{\textbackslash}'\{e\}di's cube lemma for the boolean cube.},
	urldate = {2020-08-27},
	journal = {arXiv:1911.02440 [cs]},
	author = {Aggarwal, Divesh and Bennett, Huck and Golovnev, Alexander and Stephens-Davidowitz, Noah},
	month = may,
	year = {2020},
	note = {arXiv: 1911.02440},
	keywords = {Computer Science - Computational Complexity, Computer Science - Data Structures and Algorithms},
}

